    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.0.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.0"
