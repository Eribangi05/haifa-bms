# --- core ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://rm:rm@localhost:5432/rwanda_mobility
JWT_SECRET=change-me-32+chars-random
DATA_ENC_KEY=change-me-32+chars-random-for-aes   # encrypts MFA secrets, national IDs
PIN_SECRET=change-me-32+chars-random             # derives trip PINs
FILE_SIGNING_SECRET=change-me-32+chars-random    # signs expiring document links
PUBLIC_BASE_URL=http://localhost:8080          # public https origin in production (QR codes, share links)
APP_DOWNLOAD_URL=                              # optional store link on the venue QR landing page
APP_ENV=                                       # staging = allow OTP_DEV_ECHO / simulator without warnings. Never on production
TRUST_PROXY=                                   # number of proxies in front (1 behind Caddy/Render); empty = trust
CORS_ORIGINS=                                  # comma separated browser origins; empty = open
# --- OTP / SMS ---
SMS_PROVIDER=console          # console | http  (console only logs; never use in production)
OTP_DEV_ECHO=false            # true returns OTP in API response. DEV ONLY, refused when NODE_ENV=production
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# --- payments ---
MOMO_MODE=sandbox             # sandbox | live | simulator (local fake, no network)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox
MOMO_CALLBACK_URL=
MOMO_CALLBACK_TOKEN=change-me   # shared secret appended to callback URL; callback is ALSO re-verified by status query
# --- maps ---
MOMO_CURRENCY=RWF               # sandbox accepts EUR only
PUSH_PROVIDER=none            # none | expo
EXPO_ACCESS_TOKEN=
CLAMAV_HOST=                  # optional virus scan of uploads (fail closed)
ADMIN_MFA_RESET_EMAIL=        # recovery only, see docs/OPERATIONS_RUNBOOK.md
ADMIN_MFA_RESET_TOKEN=
MAP_PROVIDER=haversine        # haversine | osrm
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# --- storage ---
STORAGE_DIR=./storage         # private directory; swap for S3-compatible adapter in production
# --- bootstrap ---
BOOTSTRAP_ADMIN_EMAIL=admin@abasare.example
BOOTSTRAP_ADMIN_PASSWORD=
