# --- core ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://rm:rm@localhost:5432/rwanda_mobility
JWT_SECRET=change-me-32+chars-random
DATA_ENC_KEY=change-me-32+chars-random-for-aes   # encrypts MFA secrets, national IDs
PIN_SECRET=change-me-32+chars-random             # derives trip PINs
FILE_SIGNING_SECRET=change-me-32+chars-random    # signs expiring document links
PUBLIC_BASE_URL=http://localhost:8080
# --- OTP / SMS ---
SMS_PROVIDER=console          # console | http  (console only logs; never use in production)
OTP_DEV_ECHO=false            # true returns OTP in API response. DEV ONLY, refused when NODE_ENV=production
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# --- payments ---
MOMO_MODE=sandbox             # sandbox | live | simulator (local fake, no network)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox
MOMO_CALLBACK_URL=
MOMO_CALLBACK_TOKEN=change-me   # shared secret appended to callback URL; callback is ALSO re-verified by status query
# --- maps ---
MAP_PROVIDER=haversine        # haversine | osrm
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# --- storage ---
STORAGE_DIR=./storage         # private directory; swap for S3-compatible adapter in production
# --- bootstrap ---
BOOTSTRAP_ADMIN_EMAIL=admin@rwandamobility.local
BOOTSTRAP_ADMIN_PASSWORD=
