{
  "expo": {
    "name": "Rwanda Mobility",
    "slug": "rwanda-mobility",
    "scheme": "rwandamobility",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#00704A" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "rw.mobility.app" },
    "android": {
      "package": "rw.mobility.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#00704A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA", "INTERNET", "ACCESS_NETWORK_STATE"],
      "blockedPermissions": ["ACCESS_BACKGROUND_LOCATION", "RECORD_AUDIO", "READ_MEDIA_VIDEO", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      ["expo-location", { "locationWhenInUsePermission": "Rwanda Mobility uses your location to set your pickup and match you with nearby drivers." }],
      ["expo-image-picker", { "cameraPermission": "Used to photograph your driver documents.", "photosPermission": "Used to attach your driver documents." }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ]
  }
}
