# Copy to deploy/.env and fill EVERY value. Never commit deploy/.env.
# Generate each secret with:  openssl rand -base64 32     (use a different value for each)
# ---- stack ----
API_DOMAIN=api.example.rw                  # DNS A record pointing at this host; Caddy gets the HTTPS certificate for it
DB_PASSWORD=                               # PostgreSQL password for the "rm" role
# ---- required secrets (the server refuses to start in production without them; each at least 16 characters, all different) ----
JWT_SECRET=
DATA_ENC_KEY=                              # encrypts MFA secrets, national IDs. LOSING IT MAKES THAT DATA UNREADABLE: back it up separately
PIN_SECRET=
FILE_SIGNING_SECRET=
# ---- public URLs ----
PUBLIC_BASE_URL=https://api.example.rw     # must be the public https origin: QR codes and trip-share links are built from it
APP_DOWNLOAD_URL=                          # optional: Play Store link shown on the venue QR landing page
# ---- first run only: creates the first super admin and prints its authenticator secret ONCE in the api logs. Remove afterwards. ----
BOOTSTRAP_ADMIN_EMAIL=admin@abasare.example
BOOTSTRAP_ADMIN_PASSWORD=
# ---- SMS (OTP). console = nothing is delivered. Use http with a licensed aggregator for real users ----
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# ---- mobile money. simulator = fake money. live needs MTN production credentials ----
MOMO_MODE=live
MOMO_BASE_URL=
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=
MOMO_CURRENCY=RWF
MOMO_CALLBACK_URL=https://api.example.rw/api/v1/webhooks/payments/mtn_momo
MOMO_CALLBACK_TOKEN=                       # >= 16 chars, secret
# ---- push notifications: none = nothing is sent; expo = Expo Push API ----
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
# ---- optional ----
CORS_ORIGINS=                              # comma separated browser origins; empty = open (bearer tokens only, no cookies)
MAP_PROVIDER=haversine
